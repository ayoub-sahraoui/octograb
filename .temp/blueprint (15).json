{
  "id": "bf8d2d3b-9ae2-4f47-89a6-82eb915f62de",
  "name": "Books to Scrape - Full Product List with Pagination and Details",
  "description": "",
  "blocks": [
    {
      "id": "0068b371-e3af-4b8a-9c22-027ae073c16d",
      "type": "navigate",
      "config": {
        "url": "https://books.toscrape.com/",
        "behavior": "same_tab",
        "timeout": 30000
      },
      "label": "Go to Books to Scrape",
      "enabled": true,
      "description": "",
      "onError": "stop",
      "maxRetries": 0,
      "retryDelay": 0,
      "index": 0
    },
    {
      "id": "fe2a8d26-0465-41cd-9287-01d33f56c062",
      "type": "loop_pagination",
      "config": {
        "paginationType": "button",
        "nextButtonSelector": {
          "type": "css",
          "value": "li.next > a"
        },
        "maxPages": 50,
        "delayBetweenPages": 2000,
        "onNoNextButton": "stop"
      },
      "label": "Paginate through all pages",
      "enabled": true,
      "description": "",
      "onError": "stop",
      "maxRetries": 0,
      "retryDelay": 0,
      "children": [
        {
          "parentBranch": "children",
          "id": "409f37bf-f0ed-4e44-a3ed-2b54229834d2",
          "type": "loop_elements",
          "config": {
            "selector": {
              "type": "css",
              "value": ".product_pod"
            },
            "maxIterations": 1000
          },
          "label": "Extract each book from listing",
          "enabled": true,
          "description": "",
          "onError": "stop",
          "maxRetries": 0,
          "retryDelay": 0,
          "children": [
            {
              "parentBranch": "children",
              "id": "87029c54-05f9-4331-b2c0-29322d2c5f79",
              "type": "extract_scope",
              "label": "Extract book metadata from listing",
              "enabled": true,
              "description": "",
              "onError": "stop",
              "maxRetries": 0,
              "retryDelay": 0,
              "config": {
                "fields": [
                  {
                    "key": "title",
                    "selector": {
                      "type": "css",
                      "value": "h3 > a"
                    },
                    "attribute": "text",
                    "label": "Book Title"
                  },
                  {
                    "key": "price",
                    "selector": {
                      "type": "css",
                      "value": ".price_color"
                    },
                    "attribute": "text",
                    "label": "Price",
                    "transformers": [
                      {
                        "type": "trim"
                      }
                    ]
                  },
                  {
                    "key": "availability",
                    "selector": {
                      "type": "css",
                      "value": ".instock.availability"
                    },
                    "attribute": "text",
                    "label": "Availability",
                    "transformers": [
                      {
                        "type": "trim"
                      }
                    ]
                  },
                  {
                    "key": "rating",
                    "selector": {
                      "type": "css",
                      "value": "p.star-rating"
                    },
                    "attribute": "class",
                    "label": "Rating",
                    "transformers": [
                      {
                        "type": "regex",
                        "pattern": "star-rating (\\w+)",
                        "flags": "",
                        "extractGroup": 1
                      }
                    ]
                  },
                  {
                    "key": "detail_url",
                    "selector": {
                      "type": "css",
                      "value": "h3 > a"
                    },
                    "attribute": "href",
                    "label": "Detail Page URL",
                    "transformers": [
                      {
                        "type": "replace",
                        "searchValue": "^",
                        "replaceValue": "https://books.toscrape.com/",
                        "global": false
                      }
                    ]
                  }
                ]
              },
              "index": 0
            },
            {
              "parentBranch": "children",
              "id": "e404ae03-0506-466b-b519-d49de89c5c8e",
              "type": "click",
              "config": {
                "selector": {
                  "type": "css",
                  "value": "h3 > a"
                },
                "openInNewTab": true,
                "delayAfter": 1000
              },
              "label": "Open book detail page",
              "enabled": true,
              "description": "",
              "onError": "stop",
              "maxRetries": 0,
              "retryDelay": 0,
              "children": [
                {
                  "parentBranch": "children",
                  "id": "926c197c-367e-41e3-a4d3-aced699d542a",
                  "type": "extract_scope",
                  "label": "Extract book details from detail page",
                  "enabled": true,
                  "description": "",
                  "onError": "stop",
                  "maxRetries": 0,
                  "retryDelay": 0,
                  "config": {
                    "fields": [
                      {
                        "key": "description",
                        "selector": {
                          "type": "css",
                          "value": "#product_description + p"
                        },
                        "attribute": "text",
                        "label": "Description"
                      },
                      {
                        "key": "upc",
                        "selector": {
                          "type": "css",
                          "value": "tr:has(th:contains('UPC')) > td"
                        },
                        "attribute": "text",
                        "label": "UPC"
                      },
                      {
                        "key": "product_type",
                        "selector": {
                          "type": "css",
                          "value": "tr:has(th:contains('Product Type')) > td"
                        },
                        "attribute": "text",
                        "label": "Product Type"
                      }
                    ]
                  },
                  "index": 0
                }
              ],
              "index": 1
            }
          ],
          "index": 0
        }
      ],
      "index": 1
    }
  ],
  "version": 1
}