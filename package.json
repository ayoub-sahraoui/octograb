{
  "name": "octograb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A visual blueprint editor for authorized website extraction.",
  "scripts": {
    "dev": "wxt -b firefox",
    "dev:firefox": "wxt -b firefox",
    "dev:chrome": "wxt -b chrome",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/editor.test.ts && node --experimental-strip-types tests/runtime.test.ts",
    "test:browser": "node tests/browser.mjs",
    "test:runner": "node --experimental-strip-types tests/runner-browser.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "mobx": "^7.0.6",
    "mobx-react-lite": "^5.1.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  }
}
